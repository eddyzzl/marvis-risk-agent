          "external_action_executed": {
            "const": false
          },
          "estimated_cost_scope": {
            "const": "contact_actions_only"
          },
          "unestimated_review_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "task_id",
          "batch_id",
          "operation",
          "status",
          "artifact_id",
          "receipt_hash",
          "evidence_url",
          "schema_version",
