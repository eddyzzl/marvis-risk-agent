          "action_count",
          "held_count",
          "estimated_cost_minor",
          "actual_cost_minor",
          "execution_mode",
          "external_action_executed",
          "estimated_cost_scope",
          "unestimated_review_count"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 120,
      "memory_limit_mb": 2048,
      "failure_policy": "fail",
      "policy": {
        "schema_version": "tool-policy.v1",
        "human_decision_gate": "required",
        "effect_authorization": "required",
        "effect_target": {
          "kind": "collection_batch",
          "id_input": "batch_id",
          "expected_statuses": [
            "queued"
          ],
          "result_status": "completed"
        }
      },
      "side_effects": [
        "write:artifact",
        "write:task"
      ]
    },
