{
  "name": "labeling",
  "version": "0.1.0",
  "display_name": "Labeling Pack",
  "description": "从还款/DPD 长表按观察期/表现期/逾期阈值构造 0/1 坏标签，含 cohort 成熟度检查确认门与 roll-rate 定坏口径建议桥接。",
  "module": "marvis.packs.labeling.tools",
  "python_requires": ">=3.10,<3.14",
  "tools": [
    {
      "name": "define_label",
      "summary": "从 DPD 长表按观察期/表现期/逾期阈值构造 0/1 坏标签，落带 target 的衍生数据集 + 定坏口径元数据；未成熟 cohort 走强制确认门。",
      "input_schema": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "workspace_revision": {
            "type": "integer",
            "minimum": 0
          },
          "analysis_generation": {
            "type": "integer",
            "minimum": 0
          },
          "id_col": {
            "type": "string",
            "minLength": 1
          },
          "mob_col": {
            "type": "string",
            "minLength": 1
          },
          "observation_window": {
            "type": "integer",
            "minimum": 0
          },
          "performance_window": {
            "type": "integer",
            "minimum": 1
          },
          "at_mob": {
            "type": "integer",
            "minimum": 1
          },
          "date_col": {
            "type": "string",
            "minLength": 1
          },
          "as_of_date": {
            "type": "string",
            "minLength": 10
          },
          "rule_kind": {
            "type": "string",
            "enum": ["dpd", "status"]
          },
          "dpd_col": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "threshold_dpd": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "status_col": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "threshold_status": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "states": {
            "type": ["array", "null"],
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cohort_col": {
            "type": "string",
            "minLength": 1
          },
          "confirm_immature_cohorts": {
            "type": "boolean"
          },
          "target_col": {
            "type": "string",
            "minLength": 1
          },
          "proposal_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "dataset_id",
          "expected_content_hash",
          "workspace_revision",
          "analysis_generation",
          "id_col",
          "mob_col",
          "cohort_col",
          "date_col",
          "as_of_date",
          "observation_window",
          "performance_window",
          "at_mob",
          "rule_kind",
          "target_col",
          "proposal_hash",
          "confirm_immature_cohorts"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": ["labeling-tool-result.v1"]
          },
          "source_dataset_id": {
            "type": "string"
          },
          "source_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_dataset_id": {
            "type": "string"
          },
          "result_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_col": {
            "type": "string"
          },
          "bad_definition": {
            "type": "object"
          },
          "n_loans": {
            "type": "integer",
            "minimum": 0
          },
          "n_bad": {
            "type": "integer",
            "minimum": 0
          },
          "n_good": {
            "type": "integer",
            "minimum": 0
          },
          "n_unmatured": {
            "type": "integer",
            "minimum": 0
          },
          "bad_rate": {
            "type": ["number", "null"]
          },
          "maturity": {
            "type": "object"
          },
          "quality": {
            "type": "object"
          },
          "proposal_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lineage": {
            "type": "object"
          },
          "workspace": {
            "type": "object"
          },
          "dataset_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "dataset_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dataset_download_url": {
            "type": "string",
            "minLength": 1
          },
          "evidence_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_download_url": {
            "type": "string",
            "minLength": 1
          },
          "red_flags": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "schema_version",
          "source_dataset_id",
          "source_content_hash",
          "result_dataset_id",
          "result_content_hash",
          "target_col",
          "bad_definition",
          "n_loans",
          "n_bad",
          "n_good",
          "n_unmatured",
          "bad_rate",
          "maturity",
          "quality",
          "proposal_hash",
          "lineage",
          "workspace",
          "dataset_artifact_id",
          "dataset_content_hash",
          "dataset_download_url",
          "evidence_artifact_id",
          "evidence_content_hash",
          "evidence_download_url",
          "red_flags"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 120,
      "failure_policy": "fail",
      "entrypoint": "tool_define_label",
      "policy": {
        "schema_version": "tool-policy.v1",
        "human_decision_gate": "required",
        "effect_authorization": "none"
      },
      "side_effects": [
        "read:dataset",
        "write:dataset",
        "write:artifact"
      ],
      "memory_limit_mb": 4096
    },
    {
      "name": "check_cohort_maturity",
      "summary": "按 vintage cohort 判定各放款 cohort 的表现期是否闭合到定坏判定 MOB；未成熟 cohort 报红旗（纳入建模将低估坏率）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "workspace_revision": {
            "type": "integer",
            "minimum": 0
          },
          "analysis_generation": {
            "type": "integer",
            "minimum": 0
          },
          "id_col": {
            "type": "string",
            "minLength": 1
          },
          "mob_col": {
            "type": "string",
            "minLength": 1
          },
          "cohort_col": {
            "type": "string",
            "minLength": 1
          },
          "date_col": {
            "type": "string",
            "minLength": 1
          },
          "as_of_date": {
            "type": "string",
            "minLength": 10
          },
          "required_mob": {
            "type": "integer",
            "minimum": 1
          },
          "observation_window": {
            "type": "integer",
            "minimum": 0
          },
          "performance_window": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "dataset_id",
          "expected_content_hash",
          "workspace_revision",
          "analysis_generation",
          "id_col",
          "mob_col",
          "cohort_col",
          "date_col",
          "as_of_date",
          "required_mob"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "required_mob": {
            "type": "integer"
          },
          "cohorts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "immature_cohorts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "all_matured": {
            "type": "boolean"
          },
          "red_flags": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "required_mob",
          "cohorts",
          "immature_cohorts",
          "all_matured",
          "red_flags"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 120,
      "failure_policy": "fail",
      "entrypoint": "tool_check_cohort_maturity",
      "side_effects": [
        "read:dataset"
      ],
      "memory_limit_mb": 4096
    },
    {
      "name": "suggest_bad_definition",
      "summary": "从既有 roll_rate_matrix 输出生成供人工评估的坏口径候选；不会自动写入或默认采用标签业务语义。",
      "input_schema": {
        "type": "object",
        "properties": {
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "at_mob": {
            "type": "integer",
            "minimum": 1
          },
          "roll_back_threshold": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "states",
          "matrix",
          "at_mob"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "suggestion": {
            "type": ["object", "null"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "suggestion",
          "message"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 60,
      "failure_policy": "fail",
      "entrypoint": "tool_suggest_bad_definition",
      "side_effects": [],
      "memory_limit_mb": 1024
    }
  ],
  "hooks": [],
  "permissions": [
    "read:dataset",
    "write:dataset",
    "write:artifact"
  ]
}
